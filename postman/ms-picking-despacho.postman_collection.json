{
  "info": {
    "_postman_id": "1059e6e2-e002-f1fc-c850-3624b69504db",
    "name": "BodegaNube - ms-picking-despacho",
    "description": "Logistica de bodega. Ejecutar en orden (Run collection): abre el picking de una orden, la empaca, le asigna transportista y la despacha con tracking. El ordenId cambia en cada ejecucion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear registro de picking (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now() % 1000000000;",
              "pm.collectionVariables.set(\"ordenId\", id);",
              "pm.collectionVariables.set(\"ordenId2\", id + 1);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"pm.response.json().estado === \\\"EN_PREPARACION\\\"\", () => pm.expect(pm.response.json().estado === \"EN_PREPARACION\").to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/picking",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ordenId\": {{ordenId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
