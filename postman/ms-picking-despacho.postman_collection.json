          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().trackingNumber.startsWith(\\\"TRK-\\\")\", () => pm.expect(pm.response.json().trackingNumber.startsWith(\"TRK-\")).to.be.true);",
              "pm.test(\"pm.response.json().estado === \\\"DESPACHADO\\\"\", () => pm.expect(pm.response.json().estado === \"DESPACHADO\").to.be.true);"
            ]
